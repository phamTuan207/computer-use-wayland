# Build artifacts - regenerated by scripts/build.py
native/pointer
native/pointer-protocol.h
native/pointer-protocol.c
native/indicator
native/presentation-protocol.h
native/presentation-protocol.c
native/background-effect-protocol.h
native/background-effect-protocol.c
native/keyboard-protocol.c
native/keyboard-protocol.h
native/modifiers
native/*.so
native/*.o
__pycache__/
*.pyc

# Runtime state, never commit these.
# browser-profile/ holds a real Chromium profile: Cookies, Login Data, History.
browser-profile/
cache/
# Screenshots may capture private windows; add a reviewed asset with -f if needed.
*.png

# Test output. These record the machine's real window titles, PIDs and
# Wayland addresses from whatever was on screen when the run happened.
tests/*-results.json
tests/zen-diagnostic.json
tests/discovery-results.json

# Local edits
*.bak
backups/

# Local-only notes and host-specific material, not part of the public repo.
/CREW.md
/TEAM.md
/COORDINATION.md
/PROGRESS.md
/sessions.json
/.commandcode/
/docs/indicator-removal-report.md
/skill/references/validation.md
/native/agent-cursor.json
/native/require-liquid
/native/visuals.json
/native/visuals-login.lua
