+# Council fix 2a (21/11/2026): a pending Super I switch used to be silently
+# dropped on ANY transient dbus error, and the re-apply was lost with it.
+# Pending is now retained until it lands, is superseded by a newer press,
+# or a 30s TTL expires (the observed stall delayed a switch by ~21s).
+# The existing 50ms pending poll does the retrying; no blocking sync loop
+# was added. Failures are logged rate-limited to stderr AND to a file,
+# because the Quickshell stderr sink is unverified.
+PENDING_TTL_SECONDS = 30.0
+LOG_RATE_LIMIT_SECONDS = 5.0
+LOG_PATH = os.path.expanduser("~/.cache/agent-computer-use/indicator-errors.log")
+
 
