+  def _log(self, message):
+    # Rate-limited failure log: same message at most once per 5s, so a
+    # 3-minute stall does not flood the journal. Always goes to a file
+    # (guaranteed sink) and to stderr (journal if Quickshell forwards it).
+    now = time.monotonic()
+    if message == self._last_log[0] and now - self._last_log[1] < LOG_RATE_LIMIT_SECONDS:
+      return
+    self._last_log = (message, now)
+    line = "%s indicator.py: %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S %z"), message)
+    try:
+      os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
+      with open(LOG_PATH, "a") as handle:
+        handle.write(line)
+    except OSError:
+      pass
+    try:
+      print(line, end="", file=sys.stderr, flush=True)
+    except (OSError, ValueError):
+      pass
 
