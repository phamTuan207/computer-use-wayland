+bool ensureIndicatorMips(SIndicatorMip& mip, const SP<Render::IFramebuffer>& source, uint64_t serial) {
+    // Invalidate first: whatever happens below, the previous chain must never be
+    // drawn against this new sample.
+    mip.ready = false;
+
+    if (!source || !g_pHyprOpenGL)
+        return false;
+
+    const int w = static_cast<int>(source->m_size.x);
+    const int h = static_cast<int>(source->m_size.y);
+    if (w < 1 || h < 1)
+        return false;
+
+    const DRMFormat fmt = source->m_drmFormat;
+    if (mip.failed && mip.width == w && mip.height == h && mip.format == fmt)
+        return false; // already known unavailable at this size + format
+
+    const auto* pf = Hyprgraphics::Egl::getPixelFormatFromDRM(fmt);
+
+    const auto giveUp = [&](const char* why, GLenum glErr) {
+        if (!mip.logged) {
+            Log::logger->log(Log::WARN,
+                             "hyprglass indicator mip unavailable ({}): sample {}x{} drm {:#x} glErr {:#x} generation {}",
+                             why, w, h, static_cast<uint32_t>(fmt), static_cast<unsigned>(glErr), serial);
+            mip.logged = true;
+        }
+        destroyIndicatorMips(mip);
+        mip.failed = true;
+        mip.width  = w;
+        mip.height = h;
+        mip.format = fmt;
+        return false;
+    };
+
+    if (!pf || !indicatorMipFormatSupported(fmt))
+        return giveUp("unsupported format", GL_NO_ERROR);
+
+    const GLint internalFormat = pf->glInternalFormat;
+
+    if (!mip.texture || mip.width != w || mip.height != h || mip.format != fmt) {
+        destroyIndicatorMips(mip);
+        mip.width  = w;
+        mip.height = h;
+        mip.format = fmt;
+        mip.levels = 1 + static_cast<int>(std::floor(std::log2(static_cast<double>(std::max(w, h)))));
+        if (!createMipObjects(mip, internalFormat))
+            return giveUp("allocation failed", glGetError());
+    }
+
+    if (!copyAndGenerateMips(mip, source))
+        return giveUp("copy/generate failed", glGetError());
+
+    mip.ready  = true;
+    mip.serial = serial;
+
+    if (!mip.logged) {
+        // Real GPU evidence of the chain: query the actual allocated level sizes.
+        GLint prevActive = GL_TEXTURE0, prevTex = 0;
+        glGetIntegerv(GL_ACTIVE_TEXTURE, &prevActive);
+        glActiveTexture(kMipUnit);
+        glGetIntegerv(GL_TEXTURE_BINDING_2D, &prevTex);
