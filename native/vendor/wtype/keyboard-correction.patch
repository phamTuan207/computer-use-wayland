+// Select XKB group g on the single uploaded keymap. No-op when already
+// selected. Never called between a key press and its release.
+static void kbcorr_select_group(struct wtype *wtype, size_t group)
+{
+	if (group == wtype->current_group) {
+		return;
+	}
+	zwp_virtual_keyboard_v1_modifiers(
+		wtype->keyboard, wtype->mod_status & ~WTYPE_MOD_CAPSLOCK, 0,
+		wtype->mod_status & WTYPE_MOD_CAPSLOCK, (uint32_t)group
+	);
+	wl_display_roundtrip(wtype->display);
+	wtype->current_group = group;
+}
