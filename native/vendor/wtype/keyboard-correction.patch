+// ---- Keyboard correction: preflight (runs before any Wayland connection) ----
+
+// Resolve a keysym to its canonical physical evdev code from an internal
+// evdev/pc105/us reference keymap. This is a physical-identity reference
+// only; it never changes the user's layout or IM state.
+static int kbcorr_resolve_phys(struct xkb_keymap *ref, xkb_keysym_t ks, unsigned int *phys_out)
+{
+	xkb_keycode_t min = xkb_keymap_min_keycode(ref);
+	xkb_keycode_t max = xkb_keymap_max_keycode(ref);
+	for (xkb_keycode_t kc = min; kc <= max; kc++) {
+		size_t nlevels = xkb_keymap_num_levels_for_key(ref, kc, 0);
+		for (size_t level = 0; level < nlevels; level++) {
+			const xkb_keysym_t *syms = NULL;
+			int n = xkb_keymap_key_get_syms_by_level(ref, kc, 0, level, &syms);
+			for (int i = 0; i < n; i++) {
+				if (syms[i] == ks) {
+					*phys_out = (unsigned int)kc - 8;
+					return 0;
+				}
+			}
+		}
+	}
+	return -1;
+}
+
+// Decode the complete bounded stdin payload for every TEXT_STDIN command
+// and convert it to an ordinary TEXT command before connecting.
+static void kbcorr_convert_stdin(struct wtype *wtype)
+{
+	for (size_t c = 0; c < wtype->command_count; c++) {
+		struct wtype_command *cmd = &wtype->commands[c];
+		if (cmd->type != WTYPE_COMMAND_TEXT_STDIN) {
+			continue;
+		}
+		// At most 32 stdin text actions of 10,000 characters each.
+		// (parse_args already rejects a second stdin placeholder.)
+		char *buf = NULL;
+		size_t len = 0, cap = 0;
+		for (;;) {
+			if (len == cap) {
+				if (cap >= 320000) {
+					fail("Stdin input exceeds the 320000-byte ceiling");
+				}
+				cap = cap ? cap * 2 : 4096;
+				if (cap > 320001) {
+					cap = 320001;
+				}
+				buf = realloc(buf, cap);
+				if (!buf) {
+					fail("Out of memory reading stdin");
+				}
+			}
+			size_t n = fread(buf + len, 1, cap - len, stdin);
+			if (n == 0) {
+				break;
+			}
+			len += n;
+			if (len > 320000) {
+				fail("Stdin input exceeds the 320000-byte ceiling");
+			}
+		}
+		buf[len] = '\0';
+		if (memchr(buf, '\0', len) != NULL) {
+			fail("NUL byte in stdin input");
+		}
+		setlocale(LC_CTYPE, "");
+		wchar_t *text = malloc((len + 1) * sizeof(wchar_t));
+		if (!text) {
+			fail("Out of memory reading stdin");
+		}
+		ssize_t ret = mbstowcs(text, buf, len + 1);
+		free(buf);
+		if (ret < 0) {
+			fail("Failed to decode stdin input");
+		}
+		if (ret > 10000) {
+			fail("Stdin input exceeds 10000 characters");
+		}
+		cmd->key_codes = calloc(ret > 0 ? (size_t)ret : 1, sizeof(cmd->key_codes[0]));
+		cmd->key_codes_len = (size_t)ret;
+		for (ssize_t k = 0; k < ret; k++) {
+			cmd->key_codes[k] = get_key_code_by_wchar(wtype, text[k]);
+		}
+		free(text);
+		cmd->type = WTYPE_COMMAND_TEXT;
+	}
+}
+
+static void kbcorr_preflight(struct wtype *wtype)
+{
+	kbcorr_convert_stdin(wtype);
+
+	struct xkb_context *ctx = xkb_context_new(XKB_CONTEXT_NO_FLAGS);
+	if (!ctx) {
+		fail("Cannot create xkb context for canonical keymap");
+	}
+	struct xkb_rule_names names = {
+		.rules = "evdev", .model = "pc105",
+		.layout = "us", .variant = "", .options = "",
+	};
+	struct xkb_keymap *ref = xkb_keymap_new_from_names(ctx, &names, XKB_KEYMAP_COMPILE_NO_FLAGS);
+	if (!ref) {
+		fail("Cannot build canonical evdev/pc105/us reference keymap");
+	}
+
+	// 1. Resolve explicit keys to canonical physical codes.
+	bool have_sentinel = false;
+	for (size_t i = 0; i < wtype->keymap_len; i++) {
+		struct keymap_entry *e = &wtype->keymap[i];
+		if (!e->is_explicit) {
+			continue;
+		}
+		if (e->xkb == XKB_KEY_VoidSymbol) {
+			e->phys = KBCORR_SENTINEL_PHYS;
+			e->is_fixed = true;
+			e->is_sentinel = true;
+			have_sentinel = true;
+			continue;
+		}
+		unsigned int phys = 0;
+		if (kbcorr_resolve_phys(ref, e->xkb, &phys) != 0) {
+			char name[64];
+			if (xkb_keysym_get_name(e->xkb, name, sizeof(name)) <= 0) {
+				snprintf(name, sizeof(name), "keysym %04x", e->xkb);
+			}
+			fail("No canonical physical identity for key '%s'", name);
+		}
+		e->phys = phys;
+		e->is_fixed = true;
+	}
+
+	// 2. Classify literal characters: fixed controls or pool literals.
+	for (size_t i = 0; i < wtype->keymap_len; i++) {
+		struct keymap_entry *e = &wtype->keymap[i];
+		if (e->is_explicit) {
+			continue;
+		}
+		wchar_t ch = e->wchr;
+		if (ch == L' ') {
+			e->phys = 57; e->is_fixed = true;
+		} else if (ch == L'\n' || ch == L'\r') {
+			e->phys = 28; e->is_fixed = true;
+		} else if (ch == L'\t') {
+			e->phys = 15; e->is_fixed = true;
+		} else if (ch == 0x1b) {
+			e->phys = 1; e->is_fixed = true;
+		} else if (ch == 0x08) {
+			e->phys = 14; e->is_fixed = true;
+		} else if (ch == 0x7f) {
+			e->phys = 111; e->is_fixed = true;
+		} else if (ch < 0x20 || (ch >= 0x7f && ch <= 0x9f)) {
+			fail("Unsupported control character U+%04X in literal text", (unsigned int)ch);
+		} else if (ch > 0xFFFF) {
+			fail("Non-BMP character U+%04X in literal text", (unsigned int)ch);
+		} else if (e->xkb == XKB_KEY_NoSymbol) {
+			fail("No keysym for literal character U+%04X", (unsigned int)ch);
+		}
+		// Otherwise: pool literal, assigned below.
+	}
+
+	// 3. Conflicts: different keysyms must never share a physical code.
+	for (size_t i = 0; i < wtype->keymap_len; i++) {
+		if (!wtype->keymap[i].is_fixed) continue;
+		for (size_t k = i + 1; k < wtype->keymap_len; k++) {
+			if (!wtype->keymap[k].is_fixed) continue;
+			if (wtype->keymap[i].phys == wtype->keymap[k].phys &&
+			    wtype->keymap[i].xkb != wtype->keymap[k].xkb) {
+				fail("Conflicting keys share physical code %u", wtype->keymap[i].phys);
+			}
+		}
+	}
+
+	// 4. Allocate pool literals from the safe pool minus reserved positions.
+	bool reserved[256] = { false };
+	for (size_t i = 0; i < wtype->keymap_len; i++) {
+		if (wtype->keymap[i].is_fixed) {
+			reserved[wtype->keymap[i].phys] = true;
+		}
+	}
+	unsigned int effpool[ARRAY_SIZE(kbcorr_pool)];
+	size_t npool = 0;
+	for (size_t i = 0; i < ARRAY_SIZE(kbcorr_pool); i++) {
+		if (!reserved[kbcorr_pool[i]]) {
+			effpool[npool++] = kbcorr_pool[i];
+		}
+	}
+	size_t j = 0;
+	for (size_t i = 0; i < wtype->keymap_len; i++) {
+		struct keymap_entry *e = &wtype->keymap[i];
+		if (e->is_explicit || e->is_fixed) {
+			continue;
+		}
+		if (npool == 0) {
+			fail("No safe physical positions remain for literal text");
+		}
+		e->page = j / npool;
+		e->phys = effpool[j % npool];
+		e->is_pool_literal = true;
+		j++;
+	}
+
+	// One keymap holds at most four XKB groups: at most 4N distinct
+	// pool literals. Refuse larger sets before any Wayland connection.
+	wtype->group_count = j == 0 ? 1 : (j + npool - 1) / npool;
+	if (wtype->group_count > 4) {
+		fail("Too many distinct literal characters for one keymap (max 4 pages)");
+	}
+
+	// 5. Ensure the unused VoidSymbol sentinel entry exists in every map.
+	if (!have_sentinel) {
+		unsigned int code = append_keymap_entry(wtype, 0, XKB_KEY_VoidSymbol);
+		struct keymap_entry *e = &wtype->keymap[code - 1];
+		e->is_explicit = true;
+		e->phys = KBCORR_SENTINEL_PHYS;
+		e->is_fixed = true;
+		e->is_sentinel = true;
+	}
+
+	// 6. Merge entries sharing both keysym and physical code (e.g. a
+	// literal newline and an explicit Return), rewriting command references.
+	size_t *canon = calloc(wtype->keymap_len, sizeof(size_t));
+	if (!canon) {
+		fail("Out of memory in preflight");
+	}
+	for (size_t i = 0; i < wtype->keymap_len; i++) {
+		canon[i] = i;
+		for (size_t k = 0; k < i; k++) {
+			if (wtype->keymap[k].xkb == wtype->keymap[i].xkb &&
+			    wtype->keymap[k].phys == wtype->keymap[i].phys &&
+			    !wtype->keymap[k].is_sentinel && !wtype->keymap[i].is_sentinel) {
+				canon[i] = canon[k];
+				break;
+			}
+		}
+	}
+	for (size_t c = 0; c < wtype->command_count; c++) {
+		struct wtype_command *cmd = &wtype->commands[c];
+		if (cmd->type == WTYPE_COMMAND_TEXT) {
+			for (size_t t = 0; t < cmd->key_codes_len; t++) {
+				cmd->key_codes[t] = (unsigned int)canon[cmd->key_codes[t] - 1] + 1;
+			}
+		} else if (cmd->type == WTYPE_COMMAND_KEY_PRESS || cmd->type == WTYPE_COMMAND_KEY_RELEASE) {
+			cmd->single_key_code = (unsigned int)canon[cmd->single_key_code - 1] + 1;
+		}
+	}
+	free(canon);
+	for (size_t c = 0; c < wtype->command_count; c++) {
+		struct wtype_command *cmd = &wtype->commands[c];
+		if (cmd->type == WTYPE_COMMAND_TEXT) {
+			for (size_t t = 0; t < cmd->key_codes_len; t++) {
+				wtype->keymap[cmd->key_codes[t] - 1].referenced = true;
+			}
+		} else if (cmd->type == WTYPE_COMMAND_KEY_PRESS || cmd->type == WTYPE_COMMAND_KEY_RELEASE) {
+			wtype->keymap[cmd->single_key_code - 1].referenced = true;
+		}
+	}
+	for (size_t i = 0; i < wtype->keymap_len; i++) {
+		if (wtype->keymap[i].is_sentinel) {
+			wtype->keymap[i].referenced = true;
+		}
+	}
+
+	// 7. Held-key scan: literal text only with no key or modifier held.
+	uint32_t mods = 0;
+	bool *held = calloc(wtype->keymap_len, sizeof(bool));
+	if (!held) {
+		fail("Out of memory in preflight");
+	}
+	for (size_t c = 0; c < wtype->command_count; c++) {
+		struct wtype_command *cmd = &wtype->commands[c];
+		switch (cmd->type) {
+		case WTYPE_COMMAND_MOD_PRESS:
+			mods |= cmd->mod;
+			break;
+		case WTYPE_COMMAND_MOD_RELEASE:
+			mods &= ~cmd->mod;
+			break;
+		case WTYPE_COMMAND_KEY_PRESS: {
+			struct keymap_entry *e = &wtype->keymap[cmd->single_key_code - 1];
+			if (e->is_sentinel) {
+				fail("Press of the reserved VoidSymbol sentinel");
+			}
+			if (held[cmd->single_key_code - 1]) {
+				fail("Key pressed while already held");
+			}
+			held[cmd->single_key_code - 1] = true;
+			break;
+		}
+		case WTYPE_COMMAND_KEY_RELEASE: {
+			struct keymap_entry *e = &wtype->keymap[cmd->single_key_code - 1];
+			if (e->is_sentinel) {
+				cmd->noop = true;
+				break;
+			}
+			if (!held[cmd->single_key_code - 1]) {
+				fail("Key released without a matching press");
+			}
+			held[cmd->single_key_code - 1] = false;
+			break;
+		}
+		case WTYPE_COMMAND_TEXT: {
+			bool all_explicit = cmd->key_codes_len > 0;
+			for (size_t t = 0; t < cmd->key_codes_len; t++) {
+				struct keymap_entry *e = &wtype->keymap[cmd->key_codes[t] - 1];
+				if (e->is_sentinel) {
+					fail("Synthetic use of the reserved VoidSymbol sentinel");
+				}
+				if (!e->is_explicit) {
+					all_explicit = false;
+				}
+			}
+			if (!all_explicit) {
+				bool any_held = mods != 0;
+				for (size_t i = 0; i < wtype->keymap_len && !any_held; i++) {
+					any_held = held[i];
+				}
+				if (any_held) {
+					fail("Literal text with a held key or modifier");
+				}
+			}
+			break;
+		}
+		default:
+			break;
+		}
+	}
+	free(held);
+	xkb_keymap_unref(ref);
+	xkb_context_unref(ctx);
+}
