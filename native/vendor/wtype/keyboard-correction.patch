+// Evdev code for the unused release-only VoidSymbol sentinel entry. It
+// sits above every real physical code used by this helper and emits no
+// physical event.
+#define KBCORR_SENTINEL_PHYS 240
+
 struct keymap_entry {
 	xkb_keysym_t xkb;
 	wchar_t wchr;
+	// Evdev physical code emitted for this entry (assigned in preflight).
+	unsigned int phys;
+	// Literal pool page; 0 for fixed/explicit entries.
+	unsigned int page;
+	// True when allocated from kbcorr_pool (paged); false when fixed.
+	bool is_pool_literal;
+	// True for explicit keys and fixed literal controls: present in
+	// every uploaded page.
+	bool is_fixed;
+	// True for the release-only VoidSymbol sentinel: emits no event.
+	bool is_sentinel;
+	// True when created by -k/-P/-p (explicit origin), false for text.
+	bool is_explicit;
+	// True when referenced by a command after preflight merging.
+	bool referenced;
 };
 
 
