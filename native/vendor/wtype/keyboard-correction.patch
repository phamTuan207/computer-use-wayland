+// An entry belongs in the uploaded map when it is the sentinel, or it is
+// referenced and either fixed or a pool literal of the current page.
+static bool kbcorr_emit_entry(struct wtype *wtype, struct keymap_entry *e)
+{
+	if (e->is_sentinel) {
+		return true;
+	}
+	if (!e->referenced) {
+		return false;
+	}
+	if (e->is_fixed) {
