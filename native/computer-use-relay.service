[Unit]
Description=Computer-use SSH session broker
BindsTo=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/computer-use-wayland
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=XDG_CACHE_HOME=%h/.cache
ExecStart=/usr/bin/python3 %h/computer-use-wayland/scripts/session_remote.py serve --socket %t/computer-use-wayland/relay.sock
RuntimeDirectory=computer-use-wayland
RuntimeDirectoryMode=0700
UMask=0077
Restart=no
KillMode=mixed
TimeoutStopSec=45
SendSIGKILL=no

[Install]
WantedBy=graphical-session.target
