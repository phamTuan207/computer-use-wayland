{"$comment":"Rung 3 run ledger row schema (R3-L1). One JSON object per line in rung3-run-log/R3-L1-grades.jsonl. Append-only. The coordinator commits the ledger after each task; scorers never write it. A row with test_row=true is the schema-proof row only and is never counted as a grade. Timestamps are ISO 8601 with timezone. key_hash is the sha256 of the frozen key file the scorer verified. evidence_manifest_hash is the sha256 from the evidence manifest for the task.","$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"evidence_manifest_hash":{"description":"sha256 from the task evidence manifest, or TEST for the schema-proof row","type":"string"},"final_grade":{"enum":["PASS","FAIL","INVALID","TEST"],"type":"string"},"invalid":{"properties":{"backup_task":{"type":["string","null"]},"is_invalid":{"type":"boolean"},"reason":{"type":["string","null"]}},"required":["is_invalid","reason","backup_task"],"type":"object"},"run_code":{"pattern":"^R3-L[0-9]+$","type":"string"},"runner_session":{"type":"string"},"scorer1":{"properties":{"files_read":{"items":{"type":"string"},"type":"array"},"key_hash":{"type":"string"},"session":{"type":"string"},"verdict":{"enum":["PASS","FAIL","INVALID"],"type":"string"}},"required":["verdict","session","files_read","key_hash"],"type":"object"},"scorer2":{"properties":{"session":{"type":"string"},"verdict":{"enum":["PASS","FAIL","INVALID"],"type":"string"}},"required":["verdict","session"],"type":"object"},"scorer3":{"properties":{"session":{"type":"string"},"verdict":{"enum":["PASS","FAIL","INVALID"],"type":"string"}},"required":["verdict","session"],"type":"object"},"task_id":{"pattern":"^(R3-[0-9]{3}|DP-0[1235]|R3-TEST)$","type":"string"},"test_row":{"type":"boolean"},"timestamps":{"properties":{"recorded_at":{"type":"string"},"scored1_at":{"type":"string"},"scored2_at":{"type":"string"},"task_end":{"type":"string"},"task_start":{"type":"string"}},"required":["task_start","task_end","scored1_at","scored2_at","recorded_at"],"type":"object"}},"required":["task_id","run_code","runner_session","scorer1","scorer2","final_grade","evidence_manifest_hash","timestamps","invalid"],"type":"object"}